# ── Inference endpoint ────────────────────────────────────────────────────────
# Base URL of the OpenAI-compatible inference endpoint. The detector appends
# `/v1/chat/completions` itself — do NOT include the /v1 suffix here.
# Options:
#   • Local vLLM (production):           http://inference-host:8000
#   • LiteLLM proxy → Claude (cloud):    http://localhost:4000
VLLM_URL=http://inference-host:8000

# Tier names — match --served-model-name in the vLLM serve command
DUAL_PASS_TIER1_NAME=qwen3-vl-32b
DUAL_PASS_TIER2_NAME=qwen3-vl-32b

# Single-pass 32B is the current production default (true)
SINGLE_PASS_32B=true
SINGLE_PASS_STEP_SEC=10.0
SINGLE_PASS_WINDOW_SEC=15.0
SINGLE_PASS_FRAMES=5

# ── YOLO models ───────────────────────────────────────────────────────────────
# Soccer-fine-tuned YOLOv8 for player detection
YOLO_MODEL_PATH=infra/models/yolov8_soccer_uisikdag.pt
YOLO_GROUNDING_ENABLED=true
YOLO_PERSON_CLASS_IDS=0
YOLO_BALL_CLASS_ID=32
USE_GPU=true

# Custom YOLOv9 ball detector (acatorcini/yolov9-soccer-ball)
BALL_CONTEXT_ENABLED=true
BALL_CONTEXT_MODEL_PATH=infra/models/v9b_best.pt
BALL_PRESENCE_VERIFIER_MODEL_PATH=infra/models/v9b_best.pt

# ── HuggingFace Hub ───────────────────────────────────────────────────────────
# Required to publish models to HF Hub. NOT required for inference (the models
# are public). Leave unset for inference-only deployments.
# HF_TOKEN=hf_...
# HUGGING_FACE_HUB_TOKEN=hf_...

# ── Storage ───────────────────────────────────────────────────────────────────
# Where reel-builder outputs land
REELS_OUTPUT_DIR=/Volumes/transit/reels
